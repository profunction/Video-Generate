{
  "name": "video-generate",
  "version": "0.8.1",
  "description": "Windows short drama storyboard and Wan video studio",
  "author": "profunction",
  "license": "MIT",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:win": "electron-builder --win nsis --x64",
    "test:desktop": "electron app/smoke.cjs"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.profunction.videogenerate",
    "productName": "Video Generate",
    "files": [
      "app/**/*",
      "package.json",
      "!app/smoke.cjs"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "asarUnpack": [
      "app/speech.ps1"
    ],
    "extraResources": [
      {
        "from": "vendor/ffmpeg",
        "to": "ffmpeg"
      }
    ]
  }
}
