{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "REPLACE_WITH_YOUR_WAN_I2V_DIFFUSION_MODEL.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "REPLACE_WITH_YOUR_WAN_TEXT_ENCODER.safetensors",
      "type": "wan"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "REPLACE_WITH_YOUR_WAN_VAE.safetensors" }
  },
  "4": {
    "class_type": "CLIPVisionLoader",
    "inputs": { "clip_name": "REPLACE_WITH_YOUR_CLIP_VISION_MODEL.safetensors" }
  },
  "5": {
    "class_type": "LoadImage",
    "inputs": { "image": "{{IMAGE}}" }
  },
  "6": {
    "class_type": "CLIPVisionEncode",
    "inputs": { "clip_vision": ["4", 0], "image": ["5", 0] }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "{{PROMPT}}", "clip": ["2", 0] }
  },
  "8": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "blurry, distorted, watermark, text", "clip": ["2", 0] }
  },
  "9": {
    "class_type": "WanImageToVideo",
    "inputs": {
      "width": 1280,
      "height": 720,
      "length": 121,
      "batch_size": 1,
      "positive": ["7", 0],
      "negative": ["8", 0],
      "vae": ["3", 0],
      "clip_vision_output": ["6", 0],
      "start_image": ["5", 0]
    }
  },
  "10": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 1,
      "steps": 20,
      "cfg": 6,
      "sampler_name": "uni_pc",
      "scheduler": "simple",
      "denoise": 1,
      "model": ["1", 0],
      "positive": ["9", 0],
      "negative": ["9", 1],
      "latent_image": ["9", 2]
    }
  },
  "11": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["10", 0], "vae": ["3", 0] }
  },
  "12": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["11", 0],
      "frame_rate": 24,
      "filename_prefix": "VideoGenerate",
      "format": "video/h264-mp4",
      "pix_fmt": "yuv420p",
      "save_output": true
    }
  }
}
